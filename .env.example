# DeepSeek OpenAI-compatible settings used by this project.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Product V1.0: single Agent by default; rag remains an explicit fallback.
CHESHU_EXECUTION_MODE=agent

# Local single-user conversation history and Agent context. The default is
# outputs/state/cheshu.sqlite3; do not commit or share this private file.
# CHESHU_DB_PATH=outputs/state/cheshu.sqlite3

# V1.2 retrieval. Keep bm25 until the local model is installed and the
# comparison evaluation passes; then switch to hybrid.
CHESHU_RETRIEVAL_MODE=bm25
CHESHU_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# Optional global override. By default, use evaluated per-profile values from
# data/registry/vector_thresholds.json.
# CHESHU_VECTOR_MIN_SCORE=0.65
CHESHU_RRF_K=60
CHESHU_RRF_VECTOR_WEIGHT=0.35
CHESHU_SEMANTIC_ONLY_MIN_SCORE=0.65
# CHESHU_VECTOR_INDEX_DIR=outputs/indexes/vehicle_book

# Optional. Defaults to outputs/logs/vehicle_book_agent.jsonl.
# CHESHU_AGENT_LOG_PATH=outputs/logs/vehicle_book_agent.jsonl
